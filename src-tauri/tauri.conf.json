{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xtobe Final Guardian",
  "version": "2.0.0",
  "identifier": "com.xtobe.finalguardian",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Xtobe Final Guardian",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY",
      "endpoints": [
        "https://xtobe.app/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Offline AI PC guardian with emulator sandbox",
    "longDescription": "Xtobe Final Guardian monitors installs, processes and network behavior with a local LLM and runs untrusted software in an embedded QEMU sandbox before allowing it on the host.",
    "resources": ["../ai-core/*", "../emulator/*", "../guardian-core/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "windows": {
      "certificateThumbprint": null,
      "nsis": { "installMode": "perMachine" },
      "wix": { "language": ["en-US"] }
    }
  }
}
