# Xtobe license server configuration (copy to .env on the deployment host).
# Never commit the real .env file.
PADDLE_WEBHOOK_SECRET=replace_with_paddle_webhook_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=use-a-16-character-google-app-password
SMTP_FROM=your-address@gmail.com
SMTP_USE_TLS=1
# Optional: absolute path to the single license ledger.
# XTOBE_LICENSE_DB=/secure/path/licenses.json

# XTOBE GUARDIAN - ORIGINAL LOCAL VOICE ENGINE
# XTOBE_VOICE_REPLIES_ENABLED=0 is the primary switch.
# ENABLE_VOICE=true is supported as a legacy compatibility alias.
# ENABLE_VOICE=false
XTOBE_PIPER_BIN=piper
XTOBE_PIPER_MODEL=C:/secure/xtobe/voices/original-xtobe-medium.onnx


# WhatsApp Cloud API bridge (secrets belong only in local .env)
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_VERIFY_TOKEN=replace_with_long_random_verification_token
WHATSAPP_ALLOWED_SENDERS=9715XXXXXXXX
WHATSAPP_ACCESS_TOKEN=replace_with_temporary_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
# XTOBE_CONNECTOR_DB=C:/secure/xtobe/connector_queue.db
