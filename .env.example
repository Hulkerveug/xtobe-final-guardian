# Xtobe license server configuration (copy to .env on the deployment host).
# Never commit the real .env file.
PADDLE_WEBHOOK_SECRET=replace_with_paddle_webhook_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=use-a-16-character-google-app-password
SMTP_FROM=your-address@gmail.com
SMTP_USE_TLS=1
# Optional: absolute path to the single license ledger.
# XTOBE_LICENSE_DB=/secure/path/licenses.json
